":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"How are residuals distributed per facility — symmetric? heavy-tailed? biased?","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"lqu4VE8tJl"}],"key":"V8viwa7K42"}],"key":"yv00kptWKQ"}],"key":"AEBbBhLDrV"},{"type":"tableRow","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"(b) correlation matrix","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"vNGbh0TgOx"}],"key":"DBLNhI5UIL"},{"type":"tableCell","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Do amenities over/under-provide together?","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"RBXacqlfhM"}],"key":"KQVRdEW1L1"},{"type":"text","value":" (e.g. do food & shopping track each other?)","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"sIjBg1qDFm"}],"key":"mGrtpkUBmf"}],"key":"jKYya4fdUn"},{"type":"tableRow","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"(c) bubble matrix","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"BytQfx6yEO"}],"key":"z0r7W4sJ1N"},{"type":"tableCell","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Which specific city deviates in which specific facility?","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"jiq8vP9Q5Z"}],"key":"QRviCoL3Fr"}],"key":"pLqwH7Q8ED"}],"key":"j9ai58k1Hp"}],"key":"dB4WnFjh6t"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"That order — distribution → association → case-level anomaly — mirrors exactly how a\nreferee reads a residual analysis.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"nwtcb36Ist"}],"key":"Jf5rg3Mxb3"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"2 · The data","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"iHIvo7Se7E"}],"identifier":"id-2-the-data","label":"2 · The data","html_id":"id-2-the-data","implicit":true,"key":"T5DCIQRC18"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"The tutorial version simulates residuals with a realistic correlation structure: five\nlatent city factors (think “economic level”, “compactness”, “ageing”…) load onto ten\nfacilities, plus noise and a handful of injected city-level anomalies:","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"eXhGt7rxKb"}],"key":"k9IYC5bbGQ"},{"type":"code","lang":"python","value":"FACILITIES = [\"Education\", \"Food\", \"Shopping\", \"Living\",\n              \"Sports and\\nEntertainment\", \"Parks\", \"Culture and\\nLeisure\",\n              \"Public\\nTransit\", \"Senior Care\", \"Healthcare\"]\n\ndef simulate_residuals(n_cities=339, seed=20260629):\n    rng = np.random.default_rng(seed)\n    latent = rng.normal(size=(n_cities, 5))          # 5 latent city factors\n    weights = np.array([...])                        # 10 × 5 loading matrix\n    noise = rng.normal(scale=0.75, size=(n_cities, len(FACILITIES)))\n    residual = latent @ weights.T + noise\n\n    # inject ~90 high-magnitude city-facility anomalies\n    for _ in range(90):\n        i, j = rng.integers(0, n_cities), rng.integers(0, len(FACILITIES))\n        residual[i, j] += rng.choice([-1, 1]) * rng.uniform(1.7, 3.3)\n\n    residual = (residual - residual.mean(axis=0)) / residual.std(axis=0)\n    residual = sign_log(residual * 1.8)              # tame the heavy tails\n    return pd.DataFrame(residual, columns=FACILITIES)","position":{"start":{"line":40,"column":1},"end":{"line":60,"column":1}},"key":"eZ3FBztTRp"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"The one transform worth stealing is ","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"GPEggFql0z"},{"type":"strong","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"sign-log","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"Erq0vd1bCx"}],"key":"U71MSHFm9A"},{"type":"text","value":": real residuals have heavy tails, and\na linear axis wastes 80 % of its range on a few extremes. Sign-log compresses magnitude\nwhile preserving sign:","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"sAm8vmwyk4"}],"key":"lxhVPLI40M"},{"type":"code","lang":"python","value":"def sign_log(values):\n    return np.sign(values) * np.log1p(np.abs(values))","position":{"start":{"line":66,"column":1},"end":{"line":69,"column":1}},"key":"icr4mqDAy4"},{"type":"heading","depth":3,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"3 · Panel (a): violin + swarm distributions","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"X6mn8h4Geo"}],"identifier":"id-3-panel-a-violin-swarm-distributions","label":"3 · Panel (a): violin + swarm distributions","html_id":"id-3-panel-a-violin-swarm-distributions","implicit":true,"key":"E8Rh6aQfVc"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Horizontal violins (one per facility), each overlaid with the raw cities as a jittered\nswarm — the violin gives shape, the swarm gives honesty (n is visible, outliers are\nindividually visible):","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"XV77y36H7w"}],"key":"MQ9b07x8eM"},{"type":"code","lang":"python","value":"def draw_violin_panel(ax, data):\n    y_positions = np.arange(len(FACILITIES))\n    values = [data[col].to_numpy() for col in FACILITIES]\n    cmap = plt.get_cmap(\"PuOr_r\")\n    colors = [cmap(i / (len(FACILITIES) - 1)) for i in range(len(FACILITIES))]\n\n    parts = ax.violinplot(values, positions=y_positions, vert=False,\n                          widths=0.72, showmedians=True, showextrema=False)\n    for body, color in zip(parts[\"bodies\"], colors):\n        body.set_facecolor(color); body.set_edgecolor(color)\n        body.set_alpha(0.35)\n\n    rng = np.random.default_rng(42)\n    for y, col, color in zip(y_positions, FACILITIES, colors):\n        jitter = rng.normal(scale=0.065, size=len(data))\n        ax.scatter(data[col], y + jitter, s=8, color=color,\n                   alpha=0.34, linewidths=0, zorder=3)\n\n    ax.axvline(0, color=\"#6b6b6b\", linewidth=0.9)   # the \"as expected\" reference\n    ax.invert_yaxis()","position":{"start":{"line":77,"column":1},"end":{"line":98,"column":1}},"key":"zdUSytj2fk"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Reading aids that cost three lines but carry the panel:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"uoJZvACtfW"}],"key":"V1a2plEOYO"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":102,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":102,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"the ","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"X9OS9e6kJO"},{"type":"strong","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"vertical zero line","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"iL4i3PrWX9"}],"key":"yRTpkg7hiW"},{"type":"text","value":" — everything right of it is over-provision, left is\nunder-provision;","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"ZBVO2LGVyQ"}],"key":"akQNiEVRSE"}],"key":"AWiVp22CJ1"},{"type":"listItem","spread":true,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"inlineCode","value":"invert_yaxis()","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"E2mTbdklh0"}],"key":"E6xQJqm3B7"},{"type":"text","value":" so the facility order matches panel (c)'s y-axis;","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"YPNBeYaInm"}],"key":"bI6vmjsefQ"}],"key":"uxYNip25Nr"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"violin alpha at 0.35 so the swarm points stay visible ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"C2amlqo03y"},{"type":"emphasis","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"through","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"WLuvFjJTec"}],"key":"ert0VJgn5M"},{"type":"text","value":" the body.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"gI0YEfXKrF"}],"key":"j61AOBOYtc"}],"key":"H0kXzhjGnw"}],"key":"lPJJjYYGyI"},{"type":"heading","depth":3,"position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"4 · Panel (b): the hybrid correlation matrix","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"JXOetPEwfW"}],"identifier":"id-4-panel-b-the-hybrid-correlation-matrix","label":"4 · Panel (b): the hybrid correlation matrix","html_id":"id-4-panel-b-the-hybrid-correlation-matrix","implicit":true,"key":"JYaspfeuhD"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"A 10 × 10 grid of tiny axes built with a ","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"VDY8Kd9tVA"},{"type":"strong","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"nested gridspec","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"wPFgy9odWq"}],"key":"e9Yx5giGQ2"},{"type":"text","value":", using each triangle for a\ndifferent encoding — scatter (raw evidence) below the diagonal, distribution on it, and\na coloured Spearman-ρ cell (the statistic) above:","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"ekArzz7UCP"}],"key":"PKOtjg0bjI"},{"type":"code","lang":"python","value":"def draw_corr_panel(fig, outer_spec, data):\n    n = len(FACILITIES)\n    inner = outer_spec.subgridspec(n, n, wspace=0.04, hspace=0.04)\n    norm = Normalize(vmin=-1, vmax=1)\n    cmap = plt.get_cmap(\"PuOr\")\n\n    for i, row in enumerate(FACILITIES):\n        for j, col in enumerate(FACILITIES):\n            ax = fig.add_subplot(inner[i, j])\n            if i == j:          # diagonal: density silhouette\n                counts, edges = np.histogram(data[col], bins=26, density=True)\n                centers = (edges[:-1] + edges[1:]) / 2\n                ax.fill_between(centers, 0, counts / counts.max(),\n                                color=\"#8064a2\", alpha=0.22)\n            elif i > j:         # lower triangle: raw scatter\n                ax.scatter(data[col], data[row], s=5,\n                           color=\"#e7a53b\", alpha=0.45, linewidths=0)\n            else:               # upper triangle: ρ as a coloured cell\n                r, p = corr_and_pvalue(data[col], data[row])\n                ax.set_facecolor(cmap(norm(r)))\n                ax.text(0.5, 0.56, f\"{r:.3f}\\n{p_stars(p)}\",\n                        ha=\"center\", va=\"center\", transform=ax.transAxes,\n                        fontsize=6.7)\n            ax.set_xticks([]); ax.set_yticks([])","position":{"start":{"line":113,"column":1},"end":{"line":138,"column":1}},"key":"h1NVHYxTym"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Significance stars are the usual thresholds:","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"vSGr0Kv2R3"}],"key":"hACyAnGej4"},{"type":"code","lang":"python","value":"def p_stars(p):\n    return \"***\" if p < 0.001 else \"**\" if p < 0.01 else \"*\" if p < 0.05 else \"\"","position":{"start":{"line":142,"column":1},"end":{"line":145,"column":1}},"key":"vdRXHPHMHB"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"xzvC2P7jjJ"}],"key":"kzxNxv86ZW"},{"type":"paragraph","position":{"start":{"line":148,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"strong","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"text","value":"Why Spearman, not Pearson?","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"XNvHVh1tCl"}],"key":"zBzMgvrVLT"},{"type":"text","value":" Residuals after sign-log are still not guaranteed\nGaussian, and equity questions care about ","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"mFpYRjEOM4"},{"type":"emphasis","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"text","value":"monotone","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"T5dBt1fqjz"}],"key":"CYuClyY9kN"},{"type":"text","value":" co-provision (“cities generous in\nX tend to be generous in Y”), not linearity. Rank correlation is the honest default —\nwith a plain-","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"ww8x11Suhd"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"DXZ9QVArYS"},{"type":"text","value":" rank fallback in the script when ","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"k7AfR007Dy"},{"type":"inlineCode","value":"scipy","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"n7SK0rAZ1L"},{"type":"text","value":" is absent.","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"QOJHtYJ5pN"}],"key":"y1WzflxjFf"}],"key":"ESFs0sT2rl"},{"type":"heading","depth":3,"position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"children":[{"type":"text","value":"5 · Panel (c): the bubble matrix","position":{"start":{"line":154,"column":1},"end":{"line":154,"column":1}},"key":"F2DyHlWiGs"}],"identifier":"id-5-panel-c-the-bubble-matrix","label":"5 · Panel (c): the bubble matrix","html_id":"id-5-panel-c-the-bubble-matrix","implicit":true,"key":"GtkcMmJBRy"},{"type":"paragraph","position":{"start":{"line":156,"column":1},"end":{"line":158,"column":1}},"children":[{"type":"text","value":"339 city columns would be unreadable, so the panel ","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"DrYFMQRMVJ"},{"type":"strong","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"curates","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"PekRTiINCJ"}],"key":"apUyWpR9Fm"},{"type":"text","value":" its x-axis: the ~36\nstrongest anomalies plus a random slice of mid-range cities, shuffled so the eye\ndoesn’t read a false gradient:","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"ne2QmTqxi3"}],"key":"uR38KD8wMI"},{"type":"code","lang":"python","value":"def draw_bubble_panel(ax, data, n_shown=72):\n    z = (data - data.mean()) / data.std()\n    strength = z.abs().max(axis=1)\n    top = list(strength.nlargest(n_shown // 2).index)      # loudest anomalies\n    middle_pool = strength.sort_values().index[n_shown : n_shown + 180]\n    middle = list(rng.choice(middle_pool, size=n_shown - len(top), replace=False))\n    city_order = top + middle\n    rng.shuffle(city_order)","position":{"start":{"line":160,"column":1},"end":{"line":169,"column":1}},"key":"HlHnQWLobS"},{"type":"paragraph","position":{"start":{"line":171,"column":1},"end":{"line":173,"column":1}},"children":[{"type":"text","value":"Each city × facility cell becomes one bubble; ","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"T0MFRTaaCy"},{"type":"strong","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"children":[{"type":"text","value":"colour carries sign and magnitude,\nsize carries magnitude only","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"Gf3J5LuKCM"}],"key":"Mt2C34djwz"},{"type":"text","value":" (redundant encoding — deliberately, so the pattern\nsurvives greyscale printing):","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"eocxRoE3Mb"}],"key":"d6zMij9NIU"},{"type":"code","lang":"python","value":"    sizes.append(8 + min(abs(value), 3.0) ** 1.7 * 19)   # perceptual size ramp\n\n    scatter = ax.scatter(xs, ys, s=sizes, c=vals, cmap=\"PuOr\",\n                         vmin=-2.6, vmax=2.6, alpha=0.86, linewidths=0)","position":{"start":{"line":175,"column":1},"end":{"line":180,"column":1}},"key":"asDJxl18Bc"},{"type":"paragraph","position":{"start":{"line":182,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"FQBNOACBQL"},{"type":"inlineCode","value":"** 1.7","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"O93KnGLwaW"},{"type":"text","value":" exponent over-drives area growth to compensate for the human tendency to\nunder-estimate area differences; the ","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"FoRbvDSWDl"},{"type":"inlineCode","value":"min(..., 3.0)","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"OF3gtTK7bw"},{"type":"text","value":" cap stops one monster outlier from\ndwarfing the panel. A size legend is faked with empty scatters:","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"Ebi9EsX3Mm"}],"key":"ANxr8Gsdy4"},{"type":"code","lang":"python","value":"    for size, label in zip(legend_sizes, [\"|z|=0.5\", \"|z|=1\", \"|z|=2\", \"|z|=3\"]):\n        ax.scatter([], [], s=size, color=\"#777777\", alpha=0.55, label=label)\n    ax.legend(title=\"Bubble size\", loc=\"center left\",\n              bbox_to_anchor=(1.10, 0.42), frameon=False)","position":{"start":{"line":186,"column":1},"end":{"line":191,"column":1}},"key":"KN9o63ChaR"},{"type":"heading","depth":3,"position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"children":[{"type":"text","value":"6 · Composition: one ","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"key":"bOuabQWWTG"},{"type"