s[ring_name], markersize=3.7,\n            markeredgecolor=\"white\", markeredgewidth=0.25, zorder=4)","position":{"start":{"line":139,"column":1},"end":{"line":157,"column":1}},"key":"OjWv9dy6M7"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":161,"column":1}},"children":[{"type":"text","value":"Why lollipops instead of bars? At 64 samples a radial bar ring turns into a solid\ncolour band; the thin stem + dot keeps each sample’s value readable and the dot gives\nthe eye a precise mark to compare against the grid arcs.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"VSp90dgIjn"}],"key":"IMiOOUvbUY"},{"type":"paragraph","position":{"start":{"line":163,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"Radial tick labels are drawn once per ring at 94° (just past the first sample), as\nwhite text on a colour-chip background so they survive crossing the stems:","position":{"start":{"line":163,"column":1},"end":{"line":163,"column":1}},"key":"A5l1lLwRGX"}],"key":"ZMOaZ6UndJ"},{"type":"code","lang":"python","value":"def add_tick_labels(ax, ring_name, rings, value_limits, ticks, color):\n    r_in, r_out = rings[ring_name]\n    for tick in ticks:\n        radius = value_to_radius(tick, value_limits, (r_in, r_out))\n        theta = np.deg2rad(94)\n        ax.text(radius * np.cos(theta), radius * np.sin(theta), f\"{tick:g}\",\n                ha=\"center\", va=\"center\", fontsize=7, color=\"white\",\n                bbox={\"facecolor\": color, \"edgecolor\": \"none\",\n                      \"pad\": 1.2, \"alpha\": 0.82}, zorder=5)","position":{"start":{"line":166,"column":1},"end":{"line":176,"column":1}},"key":"XExR3rKtSG"},{"type":"heading","depth":3,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"text","value":"6 · Sub-plot C: the marginal summaries","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"