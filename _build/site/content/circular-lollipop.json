ant thing, ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"mHWzmGYSAf"},{"type":"emphasis","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"sample identity","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"oww4Qqtkxn"}],"key":"g04ZOssDe8"},{"type":"text","value":": you can no longer see that the\n40-year-old with 15 years of schooling is the same person who owns 5 machines.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Dli62nWZmU"}],"key":"bNJR5MlZdz"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"This figure keeps identity intact. Each sample owns one ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"GhRmaiLAJF"},{"type":"strong","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"angular slot","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"wu2ioGLdRZ"}],"key":"RLky1KqJrG"},{"type":"text","value":", and every ring\nreads a different variable off that same slot:","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"d8aTFqoIjk"}],"key":"OUXpKN3lyA"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Categorical → colour","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Ycca7gQZkC"}],"key":"IlLOzr2tBz"},{"type":"text","value":" (heatmap wedges, inner rings) — pre-attentive, no scale needed;","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"HhsdTSAeHX"}],"key":"qzkmbFUMC9"}],"key":"veeil2Yuaj"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Continuous → radial length","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"ynRiDF09YJ"}],"key":"lbQiPBvLuS"},{"type":"text","value":" (lollipop stems, outer rings) — position along a common\nscale, the most accurate visual channel after aligned position.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"C7ybPkdJ3V"}],"key":"sNlOLnvUBm"}],"key":"vrNbjB5UTQ"}],"key":"TLvTGMqWUC"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"One glance connects five attributes of the same sample; one sweep around the circle\nscans the whole cohort.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"LY7Z0S07eD"}],"key":"tPm9ZA44Ub"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"2 · The data","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"KHP2xCyJrv"}],"identifier":"id-2-the-data","label":"2 · The data","html_id":"id-2-the-data","implicit":true,"key":"c6i1n8QJFj"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The dataset is simulated but shaped like real farm-household survey data — including a\nrealistic dependency (younger, better-educated farmers are more likely to have attended\ntraining):","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"f1fcyz3VBa"}],"key":"W56AUQP7Mn"},{"type":"code","lang":"python","value":"def simulate_data(n=64, seed=20260629):\n    rng = np.random.default_rng(seed)\n    ids = [str(i) for i in range(1, n + 1)]\n\n    age = np.clip(rng.normal(50, 13, n), 20, 80)\n    education = np.clip(rng.normal(8.5, 4.0, n), -2, 17)\n    area = np.clip(rng.gamma(shape=2.2, scale=0.32, size=n), 0, 1.5)\n    training_prob = np.clip(0.22 + education / 25 + (age < 45) * 0.18, 0.1, 0.9)\n    training = rng.binomial(1, training_prob)\n    machines = rng.choice([1, 2, 3, 4, 5], n, p=[0.30, 0.24, 0.20, 0.16, 0.10])\n\n    return pd.DataFrame({\n        \"ID\": ids, \"Age\": age, \"Education\": education,\n        \"Area\": area, \"Training\": training, \"Machines\": machines,\n    })","position":{"start":{"line":42,"column":1},"end":{"line":58,"column":1}},"key":"GxLsedxbeT"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Swapping in a real CSV is trivial — the plotting code only needs those six columns.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"WwXp0rpIbu"}],"key":"sB8ZXTSAzQ"},{"type":"heading","depth":3,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"3 · Ring geometry: the figure’s skeleton","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"xCP1fGO0aC"}],"identifier":"id-3-ring-geometry-the-figures-skeleton","label":"3 · Ring geometry: the figure’s skeleton","html_id":"id-3-ring-geometry-the-figures-skeleton","implicit":true,"key":"DotckQLv8a"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Everything hangs on two small helpers. ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"qgQHeKdtiN"},{"type":"inlineCode","value":"build_rings()","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Bx7BDlCfWF"},{"type":"text","value":" stacks the five rings outward\nfrom the centre (categorical rings innermost, continuous rings outside), and\n","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"idzSwdwSpZ"},{"type":"inlineCode","value":"value_to_radius()","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"W58yHltHsE"},{"type":"text","value":" linearly maps a data value into a ring’s radial band:","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Zu7Ehw18HB"}],"key":"qSdABpd9bV"},{"type":"code","lang":"python","value":"def build_rings(ring_thickness, ring_gap):\n    start = 2.05                          # radius of the central hole (legend space)\n    rings = {}\n    for name in [\"Machines\", \"Training\", \"Area\", \"Education\", \"Age\"]:\n        rings[name] = (start, start + ring_thickness)\n        start += ring_thickness + ring_gap\n    return rings\n\ndef value_to_radius(value, value_limits, radius_limits):\n    v_min, v_max = value_limits\n    r_in, r_out = radius_limits\n    value = np.clip(value, v_min, v_max)\n    return r_in + (value - v_min) / (v_max - v_min) * (r_out - r_in)","position":{"start":{"line":68,"column":1},"end":{"line":82,"column":1}},"key":"zjajqPGLp2"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"The angular skeleton is just as simple. The circle is ","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"gwLXrs3AT7"},{"type":"emphasis","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"not","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"IHvPXpBuTG"}],"key":"Sdk1UtTXWL"},{"type":"text","value":" fully closed — samples span\nfrom 90° to −180° (three quarters of the circle), leaving the left quadrant free for the\nmarginal summaries:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"WNgLfWRf9d"}],"key":"iL5xn1VN6G"},{"type":"code","lang":"python","value":"edges = np.linspace(90, -180, n + 1)      # n+1 boundaries → n angular slots\ncenters = (edges[:-1] + edges[1:]) / 2    # slot centres, one per sample","position":{"start":{"line":88,"column":1},"end":{"line":91,"column":1}},"key":"C2VhumbHrC"},{"type":"admonition","kind":"tip","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Tip","key":"cIMJIc1m7X"}],"key":"nqMhkXYdNZ"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"Note the figure is drawn on a ","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"GFH5S5lrgi"},{"type":"strong","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"plain Cartesian axis","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"Xxkl5tacvR"}],"key":"AMKpn6j5Rq"},{"type":"text","value":" (","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"XTtLsROGAq"},{"type":"inlineCode","value":"ax.set_aspect(\"equal\")","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"UFDJ7IhR8A"},{"type":"text","value":",\n","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"uEKlQunZWs"},{"type":"inlineCode","value":"ax.axis(\"off\")","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"aafazqTwEQ"},{"type":"text","value":") rather than matplotlib’s ","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"WwT29V8za2"},{"type":"inlineCode","value":"projection=\"polar\"","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"vYdzJ2Z9V9"},{"type":"text","value":". Wedge patches and\n","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"nK4rbNiOx1"},{"type":"inlineCode","value":"cos/sin","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"Mg8WWDzzCa"},{"type":"text","value":" maths give far more layout freedom — insets, labels and the legend can be\nplaced anywhere.","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"SULkQ53lTs"}],"key":"KbVGORdfnH"}],"key":"CYZ9FzZEDW"},{"type":"heading","depth":3,"position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"4 · Sub-plot A: the categorical heatmap rings","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"XJN3Ol4ovI"}],"identifier":"id-4-sub-plot-a-the-categorical-heatmap-rings","label":"4 · Sub-plot A: the categorical heatmap rings","html_id":"id-4-sub-plot-a-the-categorical-heatmap-rings","implicit":true,"key":"Ov7awCNUrn"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"A “heatmap” on a circle is nothing more than one coloured ","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"zoWyCbh30t"},{"type":"inlineCode","value":"Wedge","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"BI6HLXnsEO"},{"type":"text","value":" per sample per ring.\nThe whole sub-chart is one helper plus two calls inside the sample loop:","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"brxRTr0PIB"}],"key":"mRZjkcVsfV"},{"type":"code","lang":"python","value":"from matplotlib.patches import Wedge\n\ndef add_wedge(ax, r_in, r_out, theta1, theta2, color,\n              edgecolor=\"black\", lw=0.25, zorder=1):\n    ax.add_patch(Wedge(\n        center=(0, 0), r=r_out, theta1=theta1, theta2=theta2,\n        width=r_out - r_in,               # ring thickness → annular wedge\n        facecolor=color, edgecolor=edgecolor, linewidth=lw, zorder=zorder,\n    ))\n\n# inside the per-sample loop:\nm_col = colors[f\"Mach_{int(row['Machines'])}\"]           # 5-step colour ramp\nadd_wedge(ax, rings[\"Machines\"][0], rings[\"Machines\"][1], theta1, theta2, m_col)\n\nt_col = colors[\"Train_Yes\"] if int(row[\"Training\"]) == 1 else colors[\"Train_No\"]\nadd_wedge(ax, rings[\"Training\"][0], rings[\"Training\"][1], theta1, theta2, t_col)","position":{"start":{"line":105,"column":1},"end":{"line":122,"column":1}},"key":"tvy8Nu6bAW"},{"type":"paragraph","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"Design notes:","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"IGPkmJkRmL"}],"key":"XjCPlU72xW"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":126,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":126,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"Machines","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"uhSR6EdKb8"}],"key":"X1oiafRRJT"},{"type":"text","value":" (ordinal, 1–5) uses a ","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"NizZ0ryncm"},{"type":"emphasis","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"sequential","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"yTqRCKozaT"}],"key":"j7qW71ePER"},{"type":"text","value":" five-colour ramp — the eye should read\n“more machines = deeper colour”.","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"VRaEX9VKjc"}],"key":"DhBWCbAO30"}],"key":"w7s8E9A77s"},{"type":"listItem","spread":true,"position":{"start":{"line":128,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Training","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"ghH5pk6EmT"}],"key":"ScFFPShxBf"},{"type":"text","value":" (binary) uses two ","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"ErWmSBgb7h"},{"type":"emphasis","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"contrasting","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"ZVNbBLCvM1"}],"key":"Qql6V5rpLg"},{"type":"text","value":" hues — a yes/no should never look like a\ngradient.","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"bIjkk7TDyc"}],"key":"SF6tqyb50u"}],"key":"paj3zmaNf2"},{"type":"listItem","spread":true,"position":{"start":{"line":130,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The thin black wedge edges (","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"qr7Wz5DwMX"},{"type":"inlineCode","value":"lw=0.25","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"NtYbQfSpG3"},{"type":"text","value":") are what makes 64 tiny cells legible instead of\nmushy.","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"JW3i3WJN5N"}],"key":"gemhtuZ249"}],"key":"jNy9Eoyth0"}],"key":"c4pjSYn1n0"},{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"5 · Sub-plot B: the lollipop rings","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"b9qZfMcxKn"}],"identifier":"id-5-sub-plot-b-the-lollipop-rings","label":"5 · Sub-plot B: the lollipop rings","html_id":"id-5-sub-plot-b-the-lollipop-rings","