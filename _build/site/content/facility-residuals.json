":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"How are residuals distributed per facility — symmetric? heavy-tailed? biased?","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"No8deOlPuP"}],"key":"UfBPC2u7Sr"}],"key":"TbqAdSlzbJ"}],"key":"DaH9xuNER0"},{"type":"tableRow","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"(b) correlation matrix","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"fO9g159TUE"}],"key":"QSbaMHDqkr"},{"type":"tableCell","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Do amenities over/under-provide together?","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"qZ8caJFkXG"}],"key":"QsD2P9w1pY"},{"type":"text","value":" (e.g. do food & shopping track each other?)","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"iwmRHlrhLE"}],"key":"dsDbgIPnr2"}],"key":"D32gD3SozR"},{"type":"tableRow","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"(c) bubble matrix","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"iCicMqqNJj"}],"key":"iPfswIbfm3"},{"type":"tableCell","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Which specific city deviates in which specific facility?","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"vV3GPwZQMH"}],"key":"dm5CSkxLTS"}],"key":"Z1DXtQyxNt"}],"key":"LRRAsGmCXA"}],"key":"iBCOriqlCV"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"That order — distribution → association → case-level anomaly — mirrors exactly how a\nreferee reads a residual analysis.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"mX5NPzGWlX"}],"key":"dbRvJkd2sq"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"2 · The data","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"UBncjKXi6f"}],"identifier":"id-2-the-data","label":"2 · The data","html_id":"id-2-the-data","implicit":true,"key":"OQZaSsBO3G"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"The tutorial version simulates residuals with a realistic correlation structure: five\nlatent city factors (think “economic level”, “compactness”, “ageing”…) load onto ten\nfacilities, plus noise and a handful of injected city-level anomalies:","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"eI4jGWRRSV"}],"key":"kUErNZ0tZZ"},{"type":"code","lang":"python","value":"FACILITIES = [\"Education\", \"Food\", \"Shopping\", \"Living\",\n              \"Sports and\\nEntertainment\", \"Parks\", \"Culture and\\nLeisure\",\n              \"Public\\nTransit\", \"Senior Care\", \"Healthcare\"]\n\ndef simulate_residuals(n_cities=339, seed=20260629):\n    rng = np.random.default_rng(seed)\n    latent = rng.normal(size=(n_cities, 5))          # 5 latent city factors\n    weights = np.array([...])                        # 10 × 5 loading matrix\n    noise = rng.normal(scale=0.75, size=(n_cities, len(FACILITIES)))\n    residual = latent @ weights.T + noise\n\n    # inject ~90 high-magnitude city-facility anomalies\n    for _ in range(90):\n        i, j = rng.integers(0, n_cities), rng.integers(0, len(FACILITIES))\n        residual[i, j] += rng.choice([-1, 1]) * rng.uniform(1.7, 3.3)\n\n    residual = (residual - residual.mean(axis=0)) / residual.std(axis=0)\n    residual = sign_log(residual * 1.8)              # tame the heavy tails\n    return pd.DataFrame(residual, columns=FACILITIES)","position":{"start":{"line":40,"column":1},"end":{"line":60,"column":1}},"key":"Y9WfCFCQcC"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"The one transform worth stealing is ","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"fjRSQFDM4F"},{"type":"strong","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"sign-log","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"PXhCyIrV2R"}],"key":"M0twgAmgyZ"},{"type":"text","value":": real residuals have heavy tails, and\na linear axis wastes 80 % of its range on a few extremes. Sign-log compresses magnitude\nwhile preserving sign:","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"cnYrTUG5wH"}],"key":"G3ojA6PzdT"},{"type":"code","lang":"python","value":"def sign_log(values):\n    return np.sign(values) * np.log1p(np.abs(values))","position":{"start":{"line":66,"column":1},"end":{"line":69,"column":1}},"key":"sAmWuNkotF"},{"type":"heading","depth":3,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"3 · Panel (a): violin + swarm distributions","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"WooccKRqse"}],"identifier":"id-3-panel-a-violin-swarm-distributions","label":"3 · Panel (a): violin + swarm distributions","html_id":"id-3-panel-a-violin-swarm-distributions","implicit":true,"key":"sjbO5szdck"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Horizontal violins (one per facility), each overlaid with the raw cities as a jittered\nswarm — the violin gives shape, the swarm gives honesty (n is visible, outliers are\nindividually visible):","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"Yamp8OtDGh"}],"key":"J5JmsDrXTV"},{"type":"code","lang":"python","value":"def draw_violin_panel(ax, data):\n    y_positions = np.arange(len(FACILITIES))\n    values = [data[col].to_numpy() for col in FACILITIES]\n    cmap = plt.get_cmap(\"PuOr_r\")\n    colors = [cmap(i / (len(FACILITIES) - 1)) for i in range(len(FACILITIES))]\n\n    parts = ax.violinplot(values, positions=y_positions, vert=False,\n                          widths=0.72, showmedians=True, showextrema=False)\n    for body, color in zip(parts[\"bodies\"], colors):\n        body.set_facecolor(color); body.set_edgecolor(color)\n        body.set_alpha(0.35)\n\n    rng = np.random.default_rng(42)\n    for y, col, color in zip(y_positions, FACILITIES, colors):\n        jitter = rng.normal(scale=0.065, size=len(data))\n        ax.scatter(data[col], y + jitter, s=8, color=color,\n                   alpha=0.34, linewidths=0, zorder=3)\n\n    ax.axvline(0, color=\"#6b6b6b\", linewidth=0.9)   # the \"as expected\" reference\n    ax.invert_yaxis()","position":{"start":{"line":77,"column":1},"end":{"line":98,"column":1}},"key":"OUG749612x"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/facility-sub-violin-a2b3240fe064c268ee9a196afacc578f.jpg","alt":"Panel (a) rendered alone — violins with jittered city swarms","width":"62%","key":"mu1Eyt383j","urlSource":"figures/facility-sub-violin.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Panel (a) on its own. Each violin is one facility’s residual distribution across 339\ncities; the jittered dots are the cities themselves. Everything right of the zero line\nis over-provision.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"GS5zbGIvsq"}],"key":"TlCnLqRbPw"}],"key":"rv65EdexJF"}],"enumerator":"2","key":"SrvEkJUCTd"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Reading aids that cost three lines but carry the panel:","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"JBNmuyPnYH"}],"key":"bsLsyLYPZq"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":111,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"the ","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"wi3A0R8qBc"},{"type":"strong","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"vertical zero line","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"c5SMoIEggv"}],"key":"pPk4tCw1Jm"},{"type":"text","value":" — everything right of it is over-provision, left is\nunder-provision;","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"LrfI9ozwNc"}],"key":"rPj2Xayxf3"}],"key":"CiOFPUGEBe"},{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"inlineCode","value":"invert_yaxis()","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"vbxpBGBV6P"}],"key":"RsAvDzPknv"},{"type":"text","value":" so the facility order matches panel (c)'s y-axis;","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"ZEmThICpto"}],"key":"J6dYM3fXMe"}],"key":"xbjCIFHh3D"},{"type":"listItem","spread":true,"position":{"start":{"line":114,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"violin alpha at 0.35 so the swarm points stay visible ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"kp9f8bHoFi"},{"type":"emphasis","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"through","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"rpeb1PpTOx"}],"key":"O2Io8DGh8C"},{"type":"text","value":" the body.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"fwVGu63o0n"}],"key":"UkywBJOLTl"}],"key":"IoBHoObYdh"}],"key":"OuIxEqyvQO"},{"type":"heading","depth":3,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","value":"4 · Panel (b): the hybrid correlation matrix","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"z9pLsL6zC3"}],"identifier":"id-4-panel-b-the-hybrid-correlation-matrix","label":"4 · Panel (b): the hybrid correlation matrix","html_id":"id-4-panel-b-the-hybrid-correlation-matrix","implicit":true,"key":"jMyZsmLXBR"},{"type":"paragraph","position":{"start":{"line":118,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"A 10 × 10 grid of tiny axes built with a ","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"uQXrzFowGr"},{"type":"strong","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"nested gridspec","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"thtQ0BMx5S"}],"key":"oJJqkz8h6n"},{"type":"text","value":", using each triangle for a\ndifferent encoding — scatter (raw evidence) below the diagonal, distribution on it, and\na coloured Spearman-ρ cell (the statistic) above:","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"BRBIfA9j8g"}],"key":"tlCoip3rHV"},{"type":"code","lang":"python","value":"def draw_corr_panel(fig, outer_spec, data):\n    n = len(FACILITIES)\n    inner = outer_spec.subgridspec(n, n, wspace=0.04, hspace=0.04)\n    norm = Normalize(vmin=-1, vmax=1)\n    cmap = plt.get_cmap(\"PuOr\")\n\n    for i, row in enumerate(FACILITIES):\n        for j, col in enumerate(FACILITIES):\n            ax = fig.add_subplot(inner[i, j])\n            if i == j:          # diagonal: density silhouette\n                counts, edges = np.histogram(data[col], bins=26, density=True)\n                centers = (edges[:-1] + edges[1:]) / 2\n                ax.fill_between(centers, 0, counts / counts.max(),\n                                color=\"#8064a2\", alpha=0.22)\n            elif i > j:         # lower triangle: raw scatter\n                ax.scatter(data[col], data[row], s=5,\n                           color=\"#e7a53b\", alpha=0.45, linewidths=0)\n            else:               # upper triangle: ρ as a coloured cell\n                r, p = corr_and_pvalue(data[col], data[row])\n                ax.set_facecolor(cmap(norm(r)))\n                ax.text(0.5, 0.56, f\"{r:.3f}\\n{p_stars(p)}\",\n                        ha=\"center\", va=\"center\", transform=ax.transAxes,\n                        fontsize=6.7)\n            ax.set_xticks([]); ax.set_yticks([])","position":{"start":{"line":122,"column":1},"end":{"line":147,"column":1}},"key":"RsIQXkngwQ"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"Significance stars are the usual thresholds:","position":{"start":{"line":149,"column"