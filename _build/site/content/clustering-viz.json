{"version":3,"kind":"Article","sha256":"eb481eda734d27c02aaf659e22dbcce1ed1805999ac925e5e055456271ae297d","slug":"clustering-viz","location":"/visual/clustering-viz.md","dependencies":[],"frontmatter":{"title":"Piece 08 · Clustering visualization, basic to advanced","description":"One neighbourhood dataset, visualised from a raw KMeans scatter up to PCA/t-SNE/UMAP projections, silhouette diagnostics and a seaborn clustermap — with the R pheatmap equivalent at the end.","numbering":{"title":{"offset":1}},"thumbnail":"/clu-main-panel-a350f95f08d2109116d787fd0ed63f84.jpg","exports":[{"format":"md","filename":"clustering-viz.md","url":"/clustering-viz-59f32b94e39e3d5c8800205155ea5ec6.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Clustering visualization","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"A01Yzsn7z0"}],"identifier":"clustering-visualization","label":"Clustering visualization","html_id":"clustering-visualization","implicit":true,"key":"XO9ZP28PO5"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-main-panel-a350f95f08d2109116d787fd0ed63f84.jpg","alt":"PCA projection, silhouette plot and choose-k curve in one panel","width":"100%","key":"tuRmcDrNpl","urlSource":"figures/clu-main-panel.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"The finished panel: the three figures that turn “I ran KMeans” into “the clusters\nare real and there are four of them” — a PCA projection (a), a per-sample silhouette\nplot (b), and the silhouette-vs-k curve that justifies k = 4 (c).","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"yZFpQEFoMV"}],"key":"t3QIubhXxv"}],"key":"de2cjGKpaR"}],"enumerator":"1","key":"P0C2CpYE6E"},{"type":"heading","depth":3,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"1 · Why this matters","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"DOqJ8xg3F5"}],"identifier":"id-1-why-this-matters","label":"1 · Why this matters","html_id":"id-1-why-this-matters","implicit":true,"key":"LBSeYKK0pQ"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Clustering is unsupervised, so the visualization ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"ac2WCt1NNz"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"is","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"RsYhdiDV9P"}],"key":"I0K8n7oUxV"},{"type":"text","value":" the result — there is no\naccuracy score to fall back on. This piece walks one dataset from the most naive plot\nto the diagnostics a reviewer expects, answering three questions in order: ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"sMi0MRKbWC"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"can I see\nstructure? how many clusters? are they any good?","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"TfhiF4qRmV"}],"key":"YppaHDxgfy"}],"key":"faglgLwgwj"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"The data is a simulated ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"SyrwbvSqGn"},{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"city-neighbourhood","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"DyRri6UoZU"}],"key":"N51Ozl2TF7"},{"type":"text","value":" table — 600 neighbourhoods, eight\nsocio-environmental indicators (NDVI, building density, income, PM2.5…), built around\nfour archetypes (green suburb, dense core, industrial, old residential). One dataset\ncarries the whole tutorial:","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"GYE8lDDiWv"}],"key":"Od2wZV7PCi"},{"type":"code","lang":"python","value":"Xs = StandardScaler().fit_transform(df)      # always standardize before distance-based clustering\nkm = KMeans(n_clusters=4, n_init=10, random_state=0).fit(Xs)\nclusters = km.labels_","position":{"start":{"line":29,"column":1},"end":{"line":33,"column":1}},"key":"SHbgIMz0hq"},{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Important","key":"Ttr9rXv6Jn"}],"key":"SrXyooUuxy"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"strong","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Standardize first.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"JlBYRgaoc8"}],"key":"LOQan7XqVC"},{"type":"text","value":" KMeans, PCA, t-SNE and UMAP all use distances; a feature\nmeasured in thousands (land price) would otherwise drown one measured in [0, 1]\n(NDVI). ","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"yG2vRyaniZ"},{"type":"inlineCode","value":"StandardScaler","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"m1hFOJCmvo"},{"type":"text","value":" is not optional.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"Ov6KnV9TjV"}],"key":"MccKNovGLe"}],"key":"KyoTn3bYEU"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"2 · Level 1 — the raw scatter","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"Vgp2E6XwBP"}],"identifier":"id-2-level-1-the-raw-scatter","label":"2 · Level 1 — the raw scatter","html_id":"id-2-level-1-the-raw-scatter","implicit":true,"key":"PxvaTpxWfW"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"The simplest clustering figure: pick two interpretable features, colour points by\ncluster label, mark the centroids. It is limited (only 2 of 8 dimensions) but it is\nwhere every analysis starts:","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"rF5poIvIct"}],"key":"wu3mbEZwUO"},{"type":"code","lang":"python","value":"ax.scatter(df[\"Building density\"], df[\"NDVI\"], c=[PALETTE[i] for i in clusters],\n           s=18, alpha=0.7, edgecolor=\"white\", linewidth=0.3)\n# centroids, mapped back to the original feature units\ncent = StandardScaler().fit(df).inverse_transform(km.cluster_centers_)\nax.scatter(cent[:, b], cent[:, n], c=\"black\", s=180, marker=\"X\", zorder=5)","position":{"start":{"line":47,"column":1},"end":{"line":53,"column":1}},"key":"oojEK8wftg"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-scatter-b29db7c8957af1742bbc765fb09237e1.jpg","alt":"KMeans clusters on building density vs NDVI with centroids","width":"62%","key":"ghx3pDiYA2","urlSource":"figures/clu-sub-scatter.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Green suburbs (high NDVI, low density) separate cleanly here; other pairs of clusters\noverlap — because two features can’t show eight-dimensional separation. That is the\nmotivation for everything below.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"vqJC3b4LrK"}],"key":"xpcS6s79nP"}],"key":"fL0xYYFiVM"}],"enumerator":"2","key":"LhxDIq8MnL"},{"type":"heading","depth":3,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"3 · Level 2 — how many clusters?","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"LWW62msqRs"}],"identifier":"id-3-level-2-how-many-clusters","label":"3 · Level 2 — how many clusters?","html_id":"id-3-level-2-how-many-clusters","implicit":true,"key":"Ib13bzGNmh"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Never trust a ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"ZsmONc7AwK"},{"type":"inlineCode","value":"k","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"ZlONjFAkiY"},{"type":"text","value":" you didn’t test. Two standard curves: the ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"tSn3o9VMKX"},{"type":"strong","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"elbow","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"MS416LaDAX"}],"key":"AGghLUwMiK"},{"type":"text","value":" (within-cluster\nSSE, look for the kink) and the ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"tVz3tLppXb"},{"type":"strong","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"silhouette score","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"ypJ2inprBw"}],"key":"nllJdMVuRg"},{"type":"text","value":" (look for the peak). Here both\nagree on 4:","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"TchiAuCeqo"}],"key":"yOuueuxA5Z"},{"type":"code","lang":"python","value":"for k in range(2, 9):\n    m = KMeans(n_clusters=k, n_init=10, random_state=0).fit(Xs)\n    inertias.append(m.inertia_)\n    sils.append(silhouette_score(Xs, m.labels_))","position":{"start":{"line":70,"column":1},"end":{"line":75,"column":1}},"key":"K4dkMhIFUW"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-choosek-93f71b9f70ddc9ecfa5771614d999798.jpg","alt":"Elbow curve and silhouette-score curve, both marking k=4","width":"100%","key":"UQIqzEdigw","urlSource":"figures/clu-sub-choosek.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"The elbow bends and the silhouette peaks at the same k — the reassuring case. When\nthey disagree, prefer the silhouette (it measures separation, not just compactness).","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"qDOVGMChqt"}],"key":"IscMewDGfl"}],"key":"mdvyUlZ6e3"}],"enumerator":"3","key":"ebC9xr9Pwd"},{"type":"heading","depth":3,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"4 · Level 3 — PCA, seeing all dimensions at once","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"xIIhzg1t92"}],"identifier":"id-4-level-3-pca-seeing-all-dimensions-at-once","label":"4 · Level 3 — PCA, seeing all dimensions at once","html_id":"id-4-level-3-pca-seeing-all-dimensions-at-once","implicit":true,"key":"i6EcJ26e0g"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"To see all eight dimensions of separation, project to the directions of greatest\nvariance. Always print the ","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"jmEdAL6hdr"},{"type":"strong","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"explained-variance ratio","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"N2CLaFLQDY"}],"key":"NarLn5YEs2"},{"type":"text","value":" on the axes — a projection\nwithout it is unfalsifiable:","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"v8q2TM0SP9"}],"key":"WhIua3kbyH"},{"type":"code","lang":"python","value":"pca = PCA(n_components=3).fit(Xs)\nproj = pca.transform(Xs)\nevr = pca.explained_variance_ratio_ * 100\nax.set_xlabel(f\"PC1 ({evr[0]:.1f}%)\"); ax.set_ylabel(f\"PC2 ({evr[1]:.1f}%)\")","position":{"start":{"line":91,"column":1},"end":{"line":96,"column":1}},"key":"Acj9gLLLXW"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-pca2d-3bb24d10d2bc1acd09cb0230464bdcc6.jpg","alt":"2D PCA projection coloured by cluster","width":"60%","key":"gQiUa8SZNJ","urlSource":"figures/clu-sub-pca2d.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Two components capture ~67% of variance and the four clusters fall apart cleanly —\nthe honest evidence that the structure is real, not a 2-feature artefact.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"I73colRKSe"}],"key":"Sxv85Gtfya"}],"key":"IF9IgkP0gN"}],"enumerator":"4","key":"gnX6lvKs8H"},{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"For a third component, matplotlib’s 3D axes add depth (the same viewpoint control as\nPiece 01’s ggcube):","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"k3ZNx0zAsc"}],"key":"sOqVLgdYWF"},{"type":"code","lang":"python","value":"ax = fig.add_subplot(111, projection=\"3d\")\nax.scatter(proj[:, 0], proj[:, 1], proj[:, 2], c=colors, s=16)\nax.view_init(elev=18, azim=-60)","position":{"start":{"line":109,"column":1},"end":{"line":113,"column":1}},"key":"nlKiADM33H"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-pca3d-2f0ad1df7a486c531456e19de5bb9102.jpg","alt":"3D PCA scatter of the first three components","width":"60%","key":"gaaq2poKeq","urlSource":"figures/clu-sub-pca3d.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"PC3 adds the separation the 2D view flattens — useful for exploration, though for a\npaper a well-chosen 2D projection usually communicates better (occlusion is real in 3D).","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"poTpw1j27g"}],"key":"l5WVwAuPD1"}],"key":"kEzVsv0Blk"}],"enumerator":"5","key":"hdjK5v6EmK"},{"type":"heading","depth":3,"position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"5 · Level 4 — nonlinear projections: t-SNE vs UMAP","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"tDxKtuKA70"}],"identifier":"id-5-level-4-nonlinear-projections-t-sne-vs-umap","label":"5 · Level 4 — nonlinear projections: t-SNE vs UMAP","html_id":"id-5-level-4-nonlinear-projections-t-sne-vs-umap","implicit":true,"key":"cChA7XNk81"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"PCA is linear; manifold methods bend space to preserve ","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"eDSqBnruHo"},{"type":"emphasis","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"local","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"a2P8ma03DB"}],"key":"A1wTf5CIXT"},{"type":"text","value":" neighbourhoods, often\nseparating clusters PCA leaves touching. t-SNE and UMAP are the two standards — worth\nshowing side by side because they trade off differently:","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"Dd7ZJRGh7V"}],"key":"PHx4tMGBY1"},{"type":"code","lang":"python","value":"ts = TSNE(n_components=2, perplexity=30, init=\"pca\").fit_transform(Xs)\num = umap.UMAP(n_neighbors=15, min_dist=0.1).fit_transform(Xs)","position":{"start":{"line":129,"column":1},"end":{"line":132,"column":1}},"key":"U7yaXtlA5W"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-manifold-d328a5fdb89565cc6db1c2475615a2de.jpg","alt":"t-SNE and UMAP projections side by side","width":"100%","key":"dRG5nwcAX0","urlSource":"figures/clu-sub-manifold.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Both isolate the four clusters as islands. Caveat for captions: ","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"CI9h4L0Cuu"},{"type":"strong","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"distances between\nt-SNE/UMAP clusters are not meaningful","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"hEuPMuv348"}],"key":"qF75ixBlcn"},{"type":"text","value":" — only the grouping is. UMAP better preserves\nglobal layout and is far faster on large data; t-SNE remains the familiar default.","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"DT3DSYoUJf"}],"key":"zjlWzDLJt1"}],"key":"MHAdT22OpW"}],"enumerator":"6","key":"oZyoenAobQ"},{"type":"heading","depth":3,"position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"6 · Level 5 — silhouette diagnostics","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"iQN7wlGAC4"}],"identifier":"id-6-level-5-silhouette-diagnostics","label":"6 · Level 5 — silhouette diagnostics","html_id":"id-6-level-5-silhouette-diagnostics","implicit":true,"key":"mS05buG8Yk"},{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"The number ","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"b30hM5DRkj"},{"type":"inlineCode","value":"silhouette_score = 0.53","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"yHhiM8s27h"},{"type":"text","value":" hides the distribution. The per-sample\nsilhouette “knife” plot shows every point’s fit: wide blades = tight clusters,\nnegative values = misassigned points:","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"fWgaPapPQF"}],"key":"Ve2D8WHzJT"},{"type":"code","lang":"python","value":"sil_vals = silhouette_samples(Xs, clusters)\nfor i in range(K):\n    vals = np.sort(sil_vals[clusters == i])\n    ax.fill_betweenx(np.arange(lo, lo + len(vals)), 0, vals, facecolor=PALETTE[i])\nax.axvline(silhouette_score(Xs, clusters), color=\"#EE6C4D\", ls=\"--\")","position":{"start":{"line":149,"column":1},"end":{"line":155,"column":1}},"key":"nM8lzDcSFf"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-silhouette-0d36eb36816d7272998251e20d5598cc.jpg","alt":"Per-sample silhouette knife plot for the four clusters","width":"60%","key":"pK128FFl11","urlSource":"figures/clu-sub-silhouette.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":161,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"Four blades, all mostly right of the mean line, few negatives — the visual proof that\nk = 4 produced clean clusters, not just a good average number.","position":{"start":{"line":161,"column":1},"end":{"line":161,"column":1}},"key":"l24NqC9hn8"}],"key":"ZOXlBC4Ae7"}],"key":"SlVIKf2ACo"}],"enumerator":"7","key":"SDpscZNnae"},{"type":"heading","depth":3,"position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"7 · Level 6 — the clustermap (a heatmap with dendrograms)","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"tuQfq3WdAx"}],"identifier":"id-7-level-6-the-clustermap-a-heatmap-with-dendrograms","label":"7 · Level 6 — the clustermap (a heatmap with dendrograms)","html_id":"id-7-level-6-the-clustermap-a-heatmap-with-dendrograms","implicit":true,"key":"V8u384vSpS"},{"type":"paragraph","position":{"start":{"line":167,"column":1},"end":{"line":170,"column":1}},"children":[{"type":"text","value":"The clustermap fuses a standardized heatmap with hierarchical clustering on ","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"IoAT2r3TtV"},{"type":"strong","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"both","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"nriadmafyg"}],"key":"gYvES8fvFC"},{"type":"text","value":"\naxes — rows (neighbourhoods) reordered so similar ones sit together, columns\n(features) grouped by co-variation. The left colour strip ties rows back to the KMeans\nlabels. This is the Python equivalent of R’s ","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"Q06tM5afUi"},{"type":"strong","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"children":[{"type":"text","value":"pheatmap","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"eaa1iayZYL"}],"key":"KfaxQy4q2J"},{"type":"text","value":":","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"cSGc7c8Vaf"}],"key":"pmGMqtP1GN"},{"type":"code","lang":"python","value":"row_colors = pd.Series(clusters).map(dict(enumerate(PALETTE)))\nsns.clustermap(pd.DataFrame(Xs, columns=FEATURES), cmap=\"vlag\", center=0,\n               row_colors=row_colors, dendrogram_ratio=(0.14, 0.10))","position":{"start":{"line":172,"column":1},"end":{"line":176,"column":1}},"key":"bGIojkn2rC"},{"type":"container","kind":"figure