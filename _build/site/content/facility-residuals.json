start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"HcCLMeylJo"},{"type":"strong","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"curates","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"OHsbGdqm1g"}],"key":"Bsr8Fqo7jy"},{"type":"text","value":" its x-axis: the ~36\nstrongest anomalies plus a random slice of mid-range cities, shuffled so the eye\ndoesn’t read a false gradient:","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"ULBGXhrmAk"}],"key":"yZFjglDTD4"},{"type":"code","lang":"python","value":"def draw_bubble_panel(ax, data, n_shown=72):\n    z = (data - data.mean()) / data.std()\n    strength = z.abs().max(axis=1)\n    top = list(strength.nlargest(n_shown // 2).index)      # loudest anomalies\n    middle_pool = strength.sort_values().index[n_shown : n_shown + 180]\n    middle = list(rng.choice(middle_pool, size=n_shown - len(top), replace=False))\n    city_order = top + middle\n    rng.shuffle(city_order)","position":{"start":{"line":160,"column":1},"end":{"line":169,"column":1}},"key":"toi9qwH1EC"},{"type":"paragraph","position":{"start":{"line":171,"column":1},"end":{"line":173,"column":1}},"children":[{"type":"text","value":"Each city × facility cell becomes one bubble; ","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"vNPWqJOsHj"},{"type":"strong","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"children":[{"type":"text","value":"colour carries sign and magnitude,\nsize carries magnitude only","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"dpIXUx6pYS"}],"key":"e90yAFn7Yi"},{"type":"text","value":" (redundant encoding — deliberately, so the pattern\nsurvives greyscale printing):","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"I5jBXobIhc"}],"key":"FFgDauR69a"},{"type":"code","lang":"python","value":"    sizes.append(8 + min(abs(value), 3.0) ** 1.7 * 19)   # perceptual size ramp\n\n    scatter = ax.scatter(xs, ys, s=sizes, c=vals, cmap=\"PuOr\",\n                         vmin=-2.6, vmax=2.6, alpha=0.86, linewidths=0)","position":{"start":{"line":175,"column":1},"end":{"line":180,"column":1}},"key":"p2d2qHfa10"},{"type":"paragraph","position":{"start":{"line":182,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"GU6sYgfKH2"},{"type":"inlineCode","value":"** 1.7","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"L7Yn7iy4jW"},{"type":"text","value":" exponent over-drives area growth to compensate for the human tendency to\nunder-estimate area differences; the ","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"ghEVVLVhgg"},{"type":"inlineCode","value":"min(..., 3.0)","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"Mph92nHIVf"},{"type":"text","value":" cap stops one monster outlier from\ndwarfing the panel. A size legend is faked with empty scatters:","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"LategxFa4T"}],"key":"Nz6DmSLvl5"},{"type":"code","lang":"python","value":"    for size, label in zip(legend_sizes, [\"|z|=0.5\", \"|z|=1\", \"|z|=2\", \"|z|=3\"]):\n        ax.scatter([], [], s=size, color=\"#777777\", alpha=0.55, label=label)\n    ax.legend(title=\"Bubble size\", loc=\"center left\",\n              bbox_to_anchor=(1.10, 0.42), frameon=False)","position":{"start":{"line":186,"column":1},"end":{"line":191,"column":1}},"key":"kPxDqRa8nO"},{"type":"heading","depth":3,"position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"children":[{"type":"text","value":"6 · Composition: one ","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"key":"DdZ9vQTIt9"},{"type"