s = np.arange(n, dtype=float) * y_gap\n        ys -= ys.mean()                              # centre every column on y=0\n        positions.append([(i * x_gap, y) for y in ys])\n    return positions\n\n# neurons: one Circle per (layer, unit)\nfor li, layer in enumerate(pos):\n    for (x, y) in layer:\n        ax.add_patch(Circle((x, y), R, facecolor=NODE_COLORS[li],\n                            edgecolor=\"white\", lw=1.4, zorder=3))","position":{"start":{"line":37,"column":1},"end":{"line":55,"column":1}},"key":"H5aRwZURL5"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/nl-sub-nodes-0d1df3000119361885b5798834821132.jpg","alt":"Step 1 — neuron circles positioned by layer, no edges yet","width":"74%","key":"oQnQYhdVaz","urlSource":"figures/nl-sub-nodes.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"Step 1 rendered: 19 circles, four centred columns. ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"WyPo7PwEWo"},{"type":"inlineCode","value":"ys -= ys.mean()","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"pA6fid9EhD"},{"type":"text","value":" is the only\n“layout algorithm” needed — it vertically centres layers of different sizes.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"p9yJP9v5SP"}],"key":"aMUSENZE2X"}],"key":"wMrzcrNvON"}],"enumerator":"2","key":"BF2hFc60XK"},{"type":"heading","depth":3,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"3 · Track A, step 2: connect the layers","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"LwggSloTMf"}],"identifier":"id-3-track-a-step-2-connect-the-layers","label":"3 · Track A, step 2: connect the layers","html_id":"id-3-track-a-step-2-connect-the-layers","implicit":true,"key":"LCwwPrXTCk"},{"type":"