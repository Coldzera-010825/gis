:{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"annotate every cell","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"T2wT1Yg450"}],"key":"M3xvpbtWtc"},{"type":"text","value":" with adaptive text colour; and label the axes with class\nnames, not integers:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"skjC7UwTVw"}],"key":"jPI0D93GvT"},{"type":"code","lang":"python","value":"def draw_confusion(ax):\n    cm = confusion_matrix(y_te, y_pred, normalize=\"true\")\n    im = ax.imshow(cm, cmap=\"Blues\", vmin=0, vmax=1)\n    for i in range(N_CLASSES):\n        for j in range(N_CLASSES):\n            colour = \"white\" if cm[i, j] > 0.55 else \"#1f3044\"\n            ax.text(j, i, f\"{cm[i, j]:.2f}\", ha=\"center\", va=\"center\",\n                    fontsize=9, color=colour)\n    ax.set_xticks(range(N_CLASSES), CLASSES, rotation=35, ha=\"right\")\n    ax.set_yticks(range(N_CLASSES), CLASSES)\n    return im","position":{"start":{"line":42,"column":1},"end":{"line":54,"column":1}},"key":"DzgtPJzWcl"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/eval-sub-confusion-aa4415ed59ec3d9ee3505067e6485f59.jpg","alt":"Row-normalized annotated confusion matrix","width":"62%","key":"eC7qNG2oDk","urlSource":"figures/eval-sub-confusion.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Panel (a) on its own. The off-diagonal cells are the story: 10 % of true\nVegetation is called Cropland — the classic spectral-confusion pair.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"s0ieh6l6gw"}],"key":"iZQ5bH8zUA"}],"key":"pu965R9UvY"}],"enumerator":"2","key":"w5sR7oCjWW"},{"type":"heading","depth":3,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"3 · Panel (b): 