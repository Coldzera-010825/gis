ongest anomalies plus a random slice of mid-range cities, shuffled so the eye\ndoesn’t read a false gradient:","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"key":"fTQ7B7lIVt"}],"key":"BN5QBvC2g9"},{"type":"code","lang":"python","value":"def draw_bubble_panel(ax, data, n_shown=72):\n    z = (data - data.mean()) / data.std()\n    strength = z.abs().max(axis=1)\n    top = list(strength.nlargest(n_shown // 2).index)      # loudest anomalies\n    middle_pool = strength.sort_values().index[n_shown : n_shown + 180]\n    middle = list(rng.choice(middle_pool, size=n_shown - len(top), replace=False))\n    city_order = top + middle\n    rng.shuffle(city_order)","position":{"start":{"line":178,"column":1},"end":{"line":187,"column":1}},"key":"dgT6IWJiuP"},{"type":"paragraph","position":{"start":{"line":189,"column":1},"end":{"line":191,"column":1}},"children":[{"type":"text","value":"Each city × facility cell becomes one bubble; ","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"cpOcTB8bUZ"},{"type":"strong","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"children":[{"type":"text","value":"colour carries sign and magnitude,\nsize carries magnitude only","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"oJ0WCYxIqm"}],"key":"Jdo0TcY19G"},{"type":"text","value":" (redundant encoding — deliberately, so the pattern\nsurvives greyscale printing):","position":{"start":{"line":189,"column":1},"end":{"line":189,"column":1}},"key":"BiHc1y9otO"}],"key":"wbZ9z1Aksl"},{"type":"code","lang":"python","value":"    sizes.append(8 + min(abs(value), 3.0) ** 1.7 * 19)   # perceptual size ramp\n\n    scatter = ax.scatter(xs, ys, s=sizes, c=vals, cmap=\"PuOr\",\n                         vmin=-2.6, vmax=2.6, alpha=0.86, linewidths=0)","position":{"start":{"line":193,"column":1},"end":{"line":198,"column":1}},"key":"Q4hXELFSys"},{"type":"paragraph","position":{"start":{"line":200,