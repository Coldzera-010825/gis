te\n                counts, edges = np.histogram(data[col], bins=26, density=True)\n                centers = (edges[:-1] + edges[1:]) / 2\n                ax.fill_between(centers, 0, counts / counts.max(),\n                                color=\"#8064a2\", alpha=0.22)\n            elif i > j:         # lower triangle: raw scatter\n                ax.scatter(data[col], data[row], s=5,\n                           color=\"#e7a53b\", alpha=0.45, linewidths=0)\n            else:               # upper triangle: ρ as a coloured cell\n                r, p = corr_and_pvalue(data[col], data[row])\n                ax.set_facecolor(cmap(norm(r)))\n                ax.text(0.5, 0.56, f\"{r:.3f}\\n{p_stars(p)}\",\n                        ha=\"center\", va=\"center\", transform=ax.transAxes,\n                        fontsize=6.7)\n            ax.set_xticks([]); ax.set_yticks([])","position":{"start":{"line":113,"column":1},"end":{"line":138,"column":1}},"key":"JRJmSgjtzy"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Significance stars are the usual thresholds:","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"OHyrPgj5EE"}],"key":"gdg5TszVG6"},{"type":"code","lang":"python","value":"def p_stars(p):\n    return \"***\" if p < 0.001 else \"**\" if p < 0.01 else \"*\" if p < 0.05 else \"\"","position":{"start":{"line":142,"column":1},"end":{"line":145,"column":1}},"key":"errv3nXA6X"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"zZxMHy9imE"}],"key":"QfTVxbSnz0"},{"type":"paragraph","position":{"start":{"line":148,"column":1},"end":{"line":151,"column":1}},"children":[{"type":"strong","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"text","value":"Why Spearman, not Pearson?","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1