start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"xQvDZJyi8f"},{"type":"strong","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"children":[{"type":"text","value":"curates","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"RyZzQM1kK5"}],"key":"g6YeWPTbd3"},{"type":"text","value":" its x-axis: the ~36\nstrongest anomalies plus a random slice of mid-range cities, shuffled so the eye\ndoesn’t read a false gradient:","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"ostO6Uffh0"}],"key":"j2zAOuctHE"},{"type":"code","lang":"python","value":"def draw_bubble_panel(ax, data, n_shown=72):\n    z = (data - data.mean()) / data.std()\n    strength = z.abs().max(axis=1)\n    top = list(strength.nlargest(n_shown // 2).index)      # loudest anomalies\n    middle_pool = strength.sort_values().index[n_shown : n_shown + 180]\n    middle = list(rng.choice(middle_pool, size=n_shown - len(top), replace=False))\n    city_order = top + middle\n    rng.shuffle(city_order)","position":{"start":{"line":160,"column":1},"end":{"line":169,"column":1}},"key":"Qgop62cFpL"},{"type":"paragraph","position":{"start":{"line":171,"column":1},"end":{"line":173,"column":1}},"children":[{"type":"text","value":"Each city × facility cell becomes one bubble; ","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"uOL0GrwVha"},{"type":"strong","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"children":[{"type":"text","value":"colour carries sign and magnitude,\nsize carries magnitude only","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"fYZphS9ZLA"}],"key":"KTOdkaA4Fa"},{"type":"text","value":" (redundant encoding — deliberately, so the pattern\nsurvives greyscale printing):","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"s8Wws8KSWM"}],"key":"Mzd9knRvID"},{"type":"code","lang":"python","value":"    sizes.append(8 + min(abs(value), 3.0) ** 1.7 * 19)   # perceptual size ramp\n\n    scatter = ax.scatter(xs, ys, s=sizes, c=vals, cmap=\"PuOr\",\n                         vmin=-2.6, vmax=2.6, alpha=0.86, linewidths=0)","position":{"start":{"line":175,"column":1},"end":{"line":180,"column":1}},"key":"tGJQ4OFiXa"},{"type":"paragraph","position":{"start":{"line":182,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"IPPcJmFkRx"},{"type":"inlineCode","value":"** 1.7","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"YNYc2pvVZz"},{"type":"text","value":" exponent over-drives area growth to compensate for the human tendency to\nunder-estimate area differences; the ","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"XRzneX7PWT"},{"type":"inlineCode","value":"min(..., 3.0)","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"s1ECa0rZaB"},{"type":"text","value":" cap stops one monster outlier from\ndwarfing the panel. A size legend is faked with empty scatters:","position":{"start":{"line":182,"column":1},"end":{"line":182,"column":1}},"key":"ZfHunnPAOM"}],"key":"J1vulk0ngB"},{"type":"code","lang":"python","value":"    for size, label in zip(legend_sizes, [\"|z|=0.5\", \"|z|=1\", \"|z|=2\", \"|z|=3\"]):\n        ax.scatter([], [], s=size, color=\"#777777\", alpha=0.55, label=label)\n    ax.legend(title=\"Bubble size\", loc=\"center left\",\n              bbox_to_anchor=(1.10, 0.42), frameon=False)","position":{"start":{"line":186,"column":1},"end":{"line":191,"column":1}},"key":"fk9V010Crn"},{"type":"heading","depth":3,"position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"children":[{"type":"text","value":"6 · Composition: one ","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"key":"m88MHVhAq7"},{"type"