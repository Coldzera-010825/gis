{"version":3,"kind":"Article","sha256":"eb481eda734d27c02aaf659e22dbcce1ed1805999ac925e5e055456271ae297d","slug":"clustering-viz","location":"/visual/clustering-viz.md","dependencies":[],"frontmatter":{"title":"Piece 08 · Clustering visualization, basic to advanced","description":"One neighbourhood dataset, visualised from a raw KMeans scatter up to PCA/t-SNE/UMAP projections, silhouette diagnostics and a seaborn clustermap — with the R pheatmap equivalent at the end.","numbering":{"title":{"offset":1}},"thumbnail":"/clu-main-panel-a350f95f08d2109116d787fd0ed63f84.jpg","exports":[{"format":"md","filename":"clustering-viz.md","url":"/clustering-viz-59f32b94e39e3d5c8800205155ea5ec6.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Clustering visualization","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"TmmadSLgQD"}],"identifier":"clustering-visualization","label":"Clustering visualization","html_id":"clustering-visualization","implicit":true,"key":"TFqqh0qGVi"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-main-panel-a350f95f08d2109116d787fd0ed63f84.jpg","alt":"PCA projection, silhouette plot and choose-k curve in one panel","width":"100%","key":"DgPJaMssto","urlSource":"figures/clu-main-panel.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"The finished panel: the three figures that turn “I ran KMeans” into “the clusters\nare real and there are four of them” — a PCA projection (a), a per-sample silhouette\nplot (b), and the silhouette-vs-k curve that justifies k = 4 (c).","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"ns43jYE8AX"}],"key":"OhZ8G1GRQL"}],"key":"JCXXV1pMpr"}],"enumerator":"1","key":"jQtsVaDO0P"},{"type":"heading","depth":3,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"1 · Why this matters","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"rHz3YpH9Rq"}],"identifier":"id-1-why-this-matters","label":"1 · Why this matters","html_id":"id-1-why-this-matters","implicit":true,"key":"spQ493EFjU"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Clustering is unsupervised, so the visualization ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"TCasnRhpJh"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"is","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"CRjdmXZDzE"}],"key":"bmXGWOcWFB"},{"type":"text","value":" the result — there is no\naccuracy score to fall back on. This piece walks one dataset from the most naive plot\nto the diagnostics a reviewer expects, answering three questions in order: ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"vAfcy9tRj2"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"can I see\nstructure? how many clusters? are they any good?","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"gZTTveiGpT"}],"key":"I9DPZKEA7W"}],"key":"d6Ah2dBWON"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"The data is a simulated ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"XMj5bZhnMA"},{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"city-neighbourhood","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"gq21uqTlOX"}],"key":"cEqEowauE7"},{"type":"text","value":" table — 600 neighbourhoods, eight\nsocio-environmental indicators (NDVI, building density, income, PM2.5…), built around\nfour archetypes (green suburb, dense core, industrial, old residential). One dataset\ncarries the whole tutorial:","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"xduZ78yR6o"}],"key":"XDRrbo2uiS"},{"type":"code","lang":"python","value":"Xs = StandardScaler().fit_transform(df)      # always standardize before distance-based clustering\nkm = KMeans(n_clusters=4, n_init=10, random_state=0).fit(Xs)\nclusters = km.labels_","position":{"start":{"line":29,"column":1},"end":{"line":33,"column":1}},"key":"knUafq3eqz"},{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Important","key":"LqEge9QR7O"}],"key":"Fpy5DyKXG7"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"strong","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Standardize first.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"wcYzOWF2y7"}],"key":"wrIAUBYgYF"},{"type":"text","value":" KMeans, PCA, t-SNE and UMAP all use distances; a feature\nmeasured in thousands (land price) would otherwise drown one measured in [0, 1]\n(NDVI). ","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"GTzAqsnhe6"},{"type":"inlineCode","value":"StandardScaler","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"UOuONc76Un"},{"type":"text","value":" is not optional.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"jP9DCgOoM9"}],"key":"V5IVmDqgaP"}],"key":"al4I4jLcSo"},{"type":"heading","depth":3,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"2 · Level 1 — the raw scatter","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ZbSsh7SyqU"}],"identifier":"id-2-level-1-the-raw-scatter","label":"2 · Level 1 — the raw scatter","html_id":"id-2-level-1-the-raw-scatter","implicit":true,"key":"vKHwlC32S8"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"The simplest clustering figure: pick two interpretable features, colour points by\ncluster label, mark the centroids. It is limited (only 2 of 8 dimensions) but it is\nwhere every analysis starts:","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"zFx7UvtsK6"}],"key":"U1gH09Mt0a"},{"type":"code","lang":"python","value":"ax.scatter(df[\"Building density\"], df[\"NDVI\"], c=[PALETTE[i] for i in clusters],\n           s=18, alpha=0.7, edgecolor=\"white\", linewidth=0.3)\n# centroids, mapped back to the original feature units\ncent = StandardScaler().fit(df).inverse_transform(km.cluster_centers_)\nax.scatter(cent[:, b], cent[:, n], c=\"black\", s=180, marker=\"X\", zorder=5)","position":{"start":{"line":47,"column":1},"end":{"line":53,"column":1}},"key":"uAiKdCkAft"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-scatter-b29db7c8957af1742bbc765fb09237e1.jpg","alt":"KMeans clusters on building density vs NDVI with centroids","width":"62%","key":"N7n0ebklML","urlSource":"figures/clu-sub-scatter.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Green suburbs (high NDVI, low density) separate cleanly here; other pairs of clusters\noverlap — because two features can’t show eight-dimensional separation. That is the\nmotivation for everything below.","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"YdqWeuhIoa"}],"key":"J3QX2MnAK6"}],"key":"VkPFKWDIJb"}],"enumerator":"2","key":"Uexsp6p62C"},{"type":"heading","depth":3,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"3 · Level 2 — how many clusters?","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Zsf2Lfuc7t"}],"identifier":"id-3-level-2-how-many-clusters","label":"3 · Level 2 — how many clusters?","html_id":"id-3-level-2-how-many-clusters","implicit":true,"key":"txt4NIjhOK"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Never trust a ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"xTFYeM1epg"},{"type":"inlineCode","value":"k","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"XLLOxRPLnw"},{"type":"text","value":" you didn’t test. Two standard curves: the ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"WgsAJU7E5J"},{"type":"strong","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"elbow","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"bYaMr64DU5"}],"key":"RenMnnzB8J"},{"type":"text","value":" (within-cluster\nSSE, look for the kink) and the ","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"YwlbvREKp1"},{"type":"strong","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"silhouette score","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"no77PCi5TQ"}],"key":"QU1QIJyWrV"},{"type":"text","value":" (look for the peak). Here both\nagree on 4:","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"xskWIZ7MgW"}],"key":"ulo6ONhsq4"},{"type":"code","lang":"python","value":"for k in range(2, 9):\n    m = KMeans(n_clusters=k, n_init=10, random_state=0).fit(Xs)\n    inertias.append(m.inertia_)\n    sils.append(silhouette_score(Xs, m.labels_))","position":{"start":{"line":70,"column":1},"end":{"line":75,"column":1}},"key":"vAbMgia9tg"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-choosek-93f71b9f70ddc9ecfa5771614d999798.jpg","alt":"Elbow curve and silhouette-score curve, both marking k=4","width":"100%","key":"jQyTBi8mnC","urlSource":"figures/clu-sub-choosek.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"The elbow bends and the silhouette peaks at the same k — the reassuring case. When\nthey disagree, prefer the silhouette (it measures separation, not just compactness).","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"v7214P1pBC"}],"key":"Bk1jy2Mwmp"}],"key":"YpmKdVLLVq"}],"enumerator":"3","key":"hsyO9g8UCb"},{"type":"heading","depth":3,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"4 · Level 3 — PCA, seeing all dimensions at once","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"qyKtzG4j5G"}],"identifier":"id-4-level-3-pca-seeing-all-dimensions-at-once","label":"4 · Level 3 — PCA, seeing all dimensions at once","html_id":"id-4-level-3-pca-seeing-all-dimensions-at-once","implicit":true,"key":"wdmS8MviZq"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"To see all eight dimensions of separation, project to the directions of greatest\nvariance. Always print the ","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"hfF5fxJzsq"},{"type":"strong","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"explained-variance ratio","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"X3paDGWlot"}],"key":"JENquLuLqH"},{"type":"text","value":" on the axes — a projection\nwithout it is unfalsifiable:","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"hMxWiZwoHg"}],"key":"CyMxUL2cTc"},{"type":"code","lang":"python","value":"pca = PCA(n_components=3).fit(Xs)\nproj = pca.transform(Xs)\nevr = pca.explained_variance_ratio_ * 100\nax.set_xlabel(f\"PC1 ({evr[0]:.1f}%)\"); ax.set_ylabel(f\"PC2 ({evr[1]:.1f}%)\")","position":{"start":{"line":91,"column":1},"end":{"line":96,"column":1}},"key":"FoFdAIPKiu"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-pca2d-3bb24d10d2bc1acd09cb0230464bdcc6.jpg","alt":"2D PCA projection coloured by cluster","width":"60%","key":"C3pW1FBhl4","urlSource":"figures/clu-sub-pca2d.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"Two components capture ~67% of variance and the four clusters fall apart cleanly —\nthe honest evidence that the structure is real, not a 2-feature artefact.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"mEFssxiHI8"}],"key":"vLDgUbA5MZ"}],"key":"MnLdSWW10R"}],"enumerator":"4","key":"WCpcicasNg"},{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"For a third component, matplotlib’s 3D axes add depth (the same viewpoint control as\nPiece 01’s ggcube):","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"R0jlifjzsa"}],"key":"cMZ7mziRf0"},{"type":"code","lang":"python","value":"ax = fig.add_subplot(111, projection=\"3d\")\nax.scatter(proj[:, 0], proj[:, 1], proj[:, 2], c=colors, s=16)\nax.view_init(elev=18, azim=-60)","position":{"start":{"line":109,"column":1},"end":{"line":113,"column":1}},"key":"bpkrc3ai2s"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-pca3d-2f0ad1df7a486c531456e19de5bb9102.jpg","alt":"3D PCA scatter of the first three components","width":"60%","key":"cEDre6YzzN","urlSource":"figures/clu-sub-pca3d.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"text","value":"PC3 adds the separation the 2D view flattens — useful for exploration, though for a\npaper a well-chosen 2D projection usually communicates better (occlusion is real in 3D).","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"SptjePrqQY"}],"key":"uWRAAz1q9p"}],"key":"VUzdwBi1yO"}],"enumerator":"5","key":"nf9pwiQm4L"},{"type":"heading","depth":3,"position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"5 · Level 4 — nonlinear projections: t-SNE vs UMAP","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"yl7UcHYqwq"}],"identifier":"id-5-level-4-nonlinear-projections-t-sne-vs-umap","label":"5 · Level 4 — nonlinear projections: t-SNE vs UMAP","html_id":"id-5-level-4-nonlinear-projections-t-sne-vs-umap","implicit":true,"key":"GIpNTRVMyD"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"PCA is linear; manifold methods bend space to preserve ","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"rik7OnuXPX"},{"type":"emphasis","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"local","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"NVbwLWPwrT"}],"key":"W8EB4KN8QD"},{"type":"text","value":" neighbourhoods, often\nseparating clusters PCA leaves touching. t-SNE and UMAP are the two standards — worth\nshowing side by side because they trade off differently:","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"fM27GpAWvZ"}],"key":"CUJFDy3wmk"},{"type":"code","lang":"python","value":"ts = TSNE(n_components=2, perplexity=30, init=\"pca\").fit_transform(Xs)\num = umap.UMAP(n_neighbors=15, min_dist=0.1).fit_transform(Xs)","position":{"start":{"line":129,"column":1},"end":{"line":132,"column":1}},"key":"HXwFnzD84x"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-manifold-d328a5fdb89565cc6db1c2475615a2de.jpg","alt":"t-SNE and UMAP projections side by side","width":"100%","key":"SrMW16DNl8","urlSource":"figures/clu-sub-manifold.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Both isolate the four clusters as islands. Caveat for captions: ","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"URJt8EF4xI"},{"type":"strong","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"distances between\nt-SNE/UMAP clusters are not meaningful","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"pK50vGAYzM"}],"key":"nshhBy3kV8"},{"type":"text","value":" — only the grouping is. UMAP better preserves\nglobal layout and is far faster on large data; t-SNE remains the familiar default.","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"KvAuQaXU0z"}],"key":"lFDG6xQucH"}],"key":"M1vNXzaJU6"}],"enumerator":"6","key":"kyUk4l2WMi"},{"type":"heading","depth":3,"position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"6 · Level 5 — silhouette diagnostics","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"ZIhrokLfFI"}],"identifier":"id-6-level-5-silhouette-diagnostics","label":"6 · Level 5 — silhouette diagnostics","html_id":"id-6-level-5-silhouette-diagnostics","implicit":true,"key":"rx1YHvywIw"},{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"The number ","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"QPUDvkIcB8"},{"type":"inlineCode","value":"silhouette_score = 0.53","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"v5iqAY5vDM"},{"type":"text","value":" hides the distribution. The per-sample\nsilhouette “knife” plot shows every point’s fit: wide blades = tight clusters,\nnegative values = misassigned points:","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"LgFQOAgpIn"}],"key":"UVDnNAVoqz"},{"type":"code","lang":"python","value":"sil_vals = silhouette_samples(Xs, clusters)\nfor i in range(K):\n    vals = np.sort(sil_vals[clusters == i])\n    ax.fill_betweenx(np.arange(lo, lo + len(vals)), 0, vals, facecolor=PALETTE[i])\nax.axvline(silhouette_score(Xs, clusters), color=\"#EE6C4D\", ls=\"--\")","position":{"start":{"line":149,"column":1},"end":{"line":155,"column":1}},"key":"IGjOle9VEM"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/clu-sub-silhouette-0d36eb36816d7272998251e20d5598cc.jpg","alt":"Per-sample silhouette knife plot for the four clusters","width":"60%","key":"bKXmLAkJSj","urlSource":"figures/clu-sub-silhouette.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":161,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"Four blades, all mostly right of the mean line, few negatives — the visual proof that\nk = 4 produced clean clusters, not just a good average number.","position":{"start":{"line":161,"column":1},"end":{"line":161,"column":1}},"key":"aM1666yWqg"}],"key":"MCXFQWgjKq"}],"key":"gryy97hB6K"}],"enumerator":"7","key":"LoCGcCgxcD"},{"type":"heading","depth":3,"position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"7 · Level 6 — the clustermap (a heatmap with dendrograms)","p