":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"How are residuals distributed per facility — symmetric? heavy-tailed? biased?","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"CcnMnpeCkk"}],"key":"yE8X8cFFcZ"}],"key":"b5xhh8d7qR"}],"key":"TxkmjdcWSc"},{"type":"tableRow","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"(b) correlation matrix","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"SuIv1c0UuI"}],"key":"sExyoeSpS6"},{"type":"tableCell","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Do amenities over/under-provide together?","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"zx8PP2F8aw"}],"key":"dq7VeTJJ4b"},{"type":"text","value":" (e.g. do food & shopping track each other?)","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"eJV8fZjjfj"}],"key":"CV0nLTNFHj"}],"key":"OfXkvOwIMJ"},{"type":"tableRow","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"(c) bubble matrix","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"BQD8agnlkO"}],"key":"ItkT2Q05Mf"},{"type":"tableCell","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Which specific city deviates in which specific facility?","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"gXonS9PNKM"}],"key":"IbkZkK8Iv3"}],"key":"GA7ObF2kfN"}],"key":"OGAegJs3j6"}],"key":"XxA9Wx0vPs"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"That order — distribution → association → case-level anomaly — mirrors exactly how a\nreferee reads a residual analysis.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kGkxyx2Oka"}],"key":"sqviqM1EZZ"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"2 · The data","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"G7GcWo4pDl"}],"identifier":"id-2-the-data","label":"2 · The data","html_id":"id-2-the-data","implicit":true,"key":"jny4x9aYuC"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"The tutorial version simulates residuals with a realistic correlation structure: five\nlatent city factors (think “economic level”, “compactness”, “ageing”…) load onto ten\nfacilities, plus noise and a handful of injected city-level anomalies:","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"uRzb9UOdln"}],"key":"hTcApxnJvR"},{"type":"code","lang":"python","value":"FACILITIES = [\"Education\", \"Food\", \"Shopping\", \"Living\",\n              \"Sports and\\nEntertainment\", \"Parks\", \"Culture and\\nLeisure\",\n              \"Public\\nTransit\", \"Senior Care\", \"Healthcare\"]\n\ndef simulate_residuals(n_cities=339, seed=20260629):\n    rng = np.random.default_rng(seed)\n    latent = rng.normal(size=(n_cities, 5))          # 5 latent city factors\n    weights = np.array([...])                        # 10 × 5 loading matrix\n    noise = rng.normal(scale=0.75, size=(n_cities, len(FACILITIES)))\n    residual = latent @ weights.T + noise\n\n    # inject ~90 high-magnitude city-facility anomalies\n    for _ in range(90):\n        i, j = rng.integers(0, n_cities), rng.integers(0, len(FACILITIES))\n        residual[i, j] += rng.choice([-1, 1]) * rng.uniform(1.7, 3.3)\n\n    residual = (residual - residual.mean(axis=0)) / residual.std(axis=0)\n    residual = sign_log(residual * 1.8)              # tame the heavy tails\n    return pd.DataFrame(residual, columns=FACILITIES)","position":{"start":{"line":40,"column":1},"end":{"line":60,"column":1}},"key":"LxgcugmC65"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"The one transform worth stealing is ","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"DNCOE8x9Cy"},{"type":"strong","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"sign-log","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"SWEb1Cd0dJ"}],"key":"IBkrJvjhqO"},{"type":"text","value":": real residuals have heavy tails, and\na linear axis wastes 80 % of its range on a few extremes. Sign-log compresses magnitude\nwhile preserving sign:","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"SE4xQBV2OM"}],"key":"ABKIBKJXAA"},{"type":"code","lang":"python","value":"def sign_log(values):\n    return np.sign(values) * np.log1p(np.abs(values))","position":{"start":{"line":66,"column":1},"end":{"line":69,"column":1}},"key":"PFuRig1U4m"},{"type":"heading","depth":3,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"3 · Panel (a): violin + swarm distributions","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"kTvESDQTjl"}],"identifier":"id-3-panel-a-violin-swarm-distributions","label":"3 · Panel (a): violin + swarm distributions","html_id":"id-3-panel-a-violin-swarm-distributions","implicit":true,"key":"ZvNrNGD04y"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Horizontal violins (one per facility), each overlaid with the raw cities as a jittered\nswarm — the violin gives shape, the swarm gives honesty (n is visible, outliers are\nindividually visible):","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"zaK1fk6Gn5"}],"key":"wvvNrUNZQB"},{"type":"code","lang":"python","value":"def draw_violin_panel(ax, data):\n    y_positions = np.arange(len(FACILITIES))\n    values = [data[col].to_numpy() for col in FACILITIES]\n    cmap = plt.get_cmap(\"PuOr_r\")\n    colors = [cmap(i / (len(FACILITIES) - 1)) for i in range(len(FACILITIES))]\n\n    parts = ax.violinplot(values, positions=y_positions, vert=False,\n                          widths=0.72, showmedians=True, showextrema=False)\n    for body, color in zip(parts[\"bodies\"], colors):\n        body.set_facecolor(color); body.set_edgecolor(color)\n        body.set_alpha(0.35)\n\n    rng = np.random.default_rng(42)\n    for y, col, color in zip(y_positions, FACILITIES, colors):\n        jitter = rng.normal(scale=0.065, size=len(data))\n        ax.scatter(data[col], y + jitter, s=8, color=color,\n                   alpha=0.34, linewidths=0, zorder=3)\n\n    ax.axvline(0, color=\"#6b6b6b\", linewidth=0.9)   # the \"as expected\" reference\n    ax.invert_yaxis()","position":{"start":{"line":77,"column":1},"end":{"line":98,"column":1}},"key":"TrCO9Ouf9C"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Reading aids that cost three lines but carry the panel:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"LXaORtlHGw"}],"key":"gyuYtUsnZx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":102,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":102,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"the ","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"lDBY7quy2S"},{"type":"strong","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"vertical zero line","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"fackKbuI3e"}],"key":"zjiCSW7ZAr"},{"type":"text","value":" — everything right of it is over-provision, left is\nunder-provision;","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"vtknmRDu6l"}],"key":"qUXDpeRlVq"}],"key":"GQlGHnvsus"},{"type":"listItem","spread":true,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"inlineCode","value":"invert_yaxis()","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"SGRbEo11xY"}],"key":"mdaWywxsyb"},{"type":"text","value":" so the facility order matches panel (c)'s y-axis;","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"qJTsAZRGQL"}],"key":"pnT5wT9AiC"}],"key":"FMEo6bbUOt"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"violin alpha at 0.35 so the swarm points stay visible ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"rpxI46VOjs"},{"type":"emphasis","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"through","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"Q